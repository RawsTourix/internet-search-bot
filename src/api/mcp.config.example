{
    "servers": [
        {
            "name": "yandex_search",
            "alias": "web",
            "connect_type": "executable",
            "executable": "python",
            "args": ["src/mcp/yandex_search_mcp_server.py"],
            "env": {"DEBUG": "1"},
            "startup_required": false
        },
        {
            "name": "rosbiotech_schedule",
            "alias": "schedule",
            "connect_type": "executable",
            "executable": "python",
            "args": ["src/mcp/rosbiotech_schedule_mcp_server.py"],
            "env": {"DEBUG": "1"},
            "startup_required": false
        },
        {
            "name": "browser",
            "alias": "pw",
            "connect_type": "executable",
            "executable": "npx",
            "args": ["-y", "@playwright/mcp@latest", "--output-dir=C:\\Programming\\internet-search-bot\\.playwright-mcp", "--user-data-dir=C:\\Programming\\internet-search-bot\\.playwright-profile", "--output-mode=file"],
            "enabled": true,
            "startup_required": false
        },
        {
            "name": "remote_streamable",
            "alias": "remote",
            "connect_type": "streamable_http",
            "url": "https://mcp.example.com/mcp",
            "headers": {"Authorization": "Bearer replace_with_remote_mcp_token"},
            "enabled": false,
            "startup_required": false
        },
        {
            "name": "legacy_http",
            "alias": "legacy",
            "connect_type": "http",
            "host": "127.0.0.1",
            "port": 8080,
            "path": "/mcp",
            "enabled": false,
            "startup_required": false
        },
        {
            "name": "git",
            "alias": "git",
            "connect_type": "executable",
            "executable": "uvx",
            "args": ["mcp-server-git", "--repository", "C:/Programming/Проекты Python/internet-search-bot"],
            "enabled": false,
            "startup_required": false
        }
    ],
    "llm": {
        "api_url": "https://integrate.api.nvidia.com/v1/chat/completions",
        "api_key": "your_api_key",
        "model": "moonshotai/kimi-k2.6",
        "headers": {},
        "tokenizer_encoding": null,
        "is_openai_compatible": true,
        "max_tokens": 4096,
        "temperature": 0.35,
        "top_p": 1.0,
        "final_audit": true,
        "context_window_tokens": 262144,
        "reserved_output_tokens": 8192,
        "context_safety_ratio": 0.75,
        "context_compaction_target_ratio": 0.55,
        "enable_context_compaction": true,
        "instructions": "Ты — MC Pilot, ИИ-агент для практических и инженерных задач с доступом к внешним MCP-инструментам. MCPilot — пилот инструментов Model Context Protocol; MC Pilot — ведущий, который помогает провести задачу от запроса до результата. Твоя роль — понять цель пользователя, при необходимости использовать доступные инструменты, проверить результат и дать полезный итоговый ответ. Если можно надёжно ответить без инструментов — отвечай сам. Не выдумывай факты, источники, инструменты и результаты вызовов. Стиль ответа — спокойный, точный, прикладной и структурированный."
    },
    "runtime": {
        "mcp_startup_timeout": 30,
        "mcp_transport_call_timeout": 15,
        "mcp_reconnect_timeout": 10,
        "mcp_runtime_close_timeout": 10,
        "mcp_call_retries_after_recovery": 1
    },
    "input_runtime": {
        "enabled": true,
        "max_queued_batches_per_session": 64,
        "max_queued_bytes_per_session": 268435456,
        "max_batches_per_checkpoint": 8,
        "max_batch_bytes_per_checkpoint": 67108864,
        "claim_lease_seconds": 300,
        "max_intermediate_messages_per_cycle": 16,
        "min_intermediate_message_interval_seconds": 15.0,
        "max_intermediate_message_chars": 3500
    },
    "storage": {
        "backend": "filesystem",
        "root_dir": "storage",
        "atomic_writes": true,
        "verify_content_hash": true,
        "max_in_memory_content_bytes": 67108864
    },
    "memory": {
        "enable_result_compaction": true,
        "inline_result_max_input_ratio": 0.10,
        "single_pass_summary_max_input_ratio": 0.60,
        "result_summary_target_tokens": 256,
        "result_compaction_max_output_tokens": 2048,
        "result_preview_max_chars": 4000,
        "cycle_compaction_summary_target_tokens": 512,
        "cycle_compaction_max_output_tokens": 2048,
        "cycle_compaction_keep_recent_blocks": 2,
        "cycle_compaction_max_passes": 3
    },
    "artifacts": {
        "enabled": true,
        "max_artifacts_per_cycle": 32,
        "max_versions_per_lineage": 64,
        "max_artifact_size_bytes": 67108864,
        "max_inline_text_chars": 20000,
        "max_read_chars": 100000,
        "max_search_matches": 20,
        "max_patch_operations": 32,
        "max_patchable_text_bytes": 8388608,
        "max_patch_old_text_chars": 20000,
        "max_patch_new_text_chars": 50000,
        "max_runtime_artifact_summaries": 12,
        "max_concurrent_artifact_reads": 4,
        "max_composite_result_bytes": 8388608,
        "allow_opaque_binary": true,
        "auto_select_deliverables": false,
        "local_workspace_server_names": [],
        "max_container_entries_inspected": 2048,
        "max_workspace_bytes": 268435456,
        "workspace_ttl_seconds": 3600,
        "delivery_claim_timeout_seconds": 900,
        "trace_enabled": true,
        "trace_max_file_bytes": 8388608,
        "trace_max_string_chars": 2000
    },
    "ingress": {
        "enabled": true,
        "max_events_per_batch": 64,
        "max_attachments_per_batch": 32,
        "max_batch_total_bytes": 268435456,
        "max_text_parts_per_batch": 64,
        "max_text_part_chars": 100000,
        "max_semantic_parts_per_batch": 128,
        "max_semantic_metadata_bytes_per_part": 16384,
        "max_semantic_total_bytes": 524288,
        "max_poll_options": 20,
        "max_poll_option_chars": 1000,
        "max_vcard_chars": 16384,
        "media_group_quiet_timeout_seconds": 0.8,
        "media_group_sealing_grace_seconds": 0.5,
        "media_group_maximum_wait_seconds": 300,
        "standalone_attachment_maximum_wait_seconds": 2,
        "explicit_collection_idle_timeout_seconds": 3600
    },
    "client_capabilities": {
        "contract_version": 1,
        "reject_unknown_features": true,
        "max_feature_count": 64,
        "max_limit_count": 64
    },
    "localization": {
        "default_locale": "ru",
        "supported_locales": ["ru", "en"],
        "fallback_locale": "ru",
        "fail_on_missing_required_key": false,
        "max_params": 32,
        "max_param_chars": 2000
    },
    "input_presentation": {
        "enabled": true,
        "reservation_timeout_seconds": 30,
        "update_throttle_seconds": 1.0,
        "max_updates_per_batch": 64
    },
    "output_runtime": {
        "enabled": true,
        "max_parts_per_batch": 64,
        "max_total_artifacts": 32,
        "max_delivery_groups": 16,
        "max_text_chars": 200000,
        "max_metadata_bytes": 65536,
        "delivery_claim_timeout_seconds": 900
    },
    "telegram_output": {
        "prefer_document_groups": true,
        "status_message_editing": true
    },
    "planning": {
        "enabled": true,
        "max_nodes": 32,
        "max_dependencies_per_node": 16,
        "max_ready_nodes_in_context": 5,
        "max_plan_get_limit": 20,
        "max_reconciliation_attempts": 2,
        "max_title_chars": 160,
        "max_objective_chars": 2000,
        "max_outcome_summary_chars": 4000,
        "max_success_criteria_per_node": 20
    }
}
