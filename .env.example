# Конфигурация Telegram
BOT_TOKEN="your_bot_token"
# Публичный HTTPS-домен без завершающего слеша, например https://bot.example.com
WEBHOOK_DOMAIN="https://example.com"
WEBHOOK_SECRET="replace_with_random_webhook_secret"
# Отдельный ключ Telegram transport для запросов к Gateway.
TELEGRAM_API_KEY="replace_with_random_telegram_api_key"
TELEGRAM_PROGRESS_CALLBACK_URL="http://127.0.0.1:8001/internal/progress"
# Если оставить пустым, Telegram server использует WEBHOOK_SECRET.
TELEGRAM_PROGRESS_CALLBACK_TOKEN="replace_with_random_progress_callback_token"

# Файловый провайдер для Telegram
# Значение должно совпадать у Gateway и Telegram server.
# Если оставить пустым, Telegram server использует WEBHOOK_SECRET.
TELEGRAM_FILE_PROVIDER_TOKEN="replace_with_random_file_provider_token"
TELEGRAM_FILE_PROVIDER_URL="http://127.0.0.1:8001"
TELEGRAM_BOT_INSTANCE_ID="default"
# Период тишины закрывает состав альбома, но не прерывает активные загрузки.
TELEGRAM_MEDIA_GROUP_QUIET_PERIOD_SECONDS="2.5"
# Аварийный предел жизни альбома; частичный InputBatch по нему не коммитится.
TELEGRAM_MEDIA_GROUP_MAX_LIFETIME_SECONDS="300"
# До этого размера delivery держится в RAM, затем SpooledTemporaryFile уходит на диск.
TELEGRAM_DELIVERY_SPOOL_MEMORY_BYTES="8388608"

# Telegram READY OutputBatch recovery
# Worker автоматически поднимает только достаточно старые FINAL + READY batches.
TELEGRAM_READY_OUTBOX_POLL_SECONDS="15"
TELEGRAM_READY_OUTBOX_MINIMUM_AGE_SECONDS="30"
TELEGRAM_READY_OUTBOX_BATCH_LIMIT="50"

# Telegram progress/final edit UX
PROGRESS_EDIT_MIN_INTERVAL="1.2"
PROGRESS_MAX_TEXT_LENGTH="1000"
TELEGRAM_FINAL_EDIT_MAX_LENGTH="3500"
TELEGRAM_FINAL_DELIVERY_MODE="send_new"

# Запуск Telegram ASGI через: python -m src.servers.telegram
TELEGRAM_SERVER_HOST="0.0.0.0"
TELEGRAM_SERVER_PORT="8001"

# Конфигурация Web
WEB_API_KEY="replace_with_random_web_api_key"

# Конфигурация CLI
# Ключ зарезервирован для CLI transport/API.
CLI_API_KEY="replace_with_random_cli_api_key"

# Конфигурация Gateway
GATEWAY_URL="http://localhost:8000"
# Полный internal wildcard-доступ для административных/compatibility маршрутов.
INTERNAL_API_KEY="replace_with_random_internal_api_key"
PROGRESS_CALLBACK_ALLOWED_PREFIXES="http://127.0.0.1,http://localhost"
CORS_ORIGINS="*"

# Прокси
HTTP_PROXY=""
HTTPS_PROXY=""
# Не отправлять локальные Gateway/Telegram callbacks через внешний proxy.
NO_PROXY="127.0.0.1,localhost"

# Конфигурация MCP/агента
AGENT_CONFIG_PATH="src/api/mcp.config"
