# Конфигурация Telegram
BOT_TOKEN="your_bot_token"
WEBHOOK_DOMAIN="https://example.com" # Публичный HTTPS-домен без завершающего слеша, например https://bot.example.com
WEBHOOK_SECRET="replace_with_random_webhook_secret"
TELEGRAM_API_KEY="replace_with_random_telegram_api_key" # Отдельный ключ Telegram transport для запросов к Gateway
TELEGRAM_PROGRESS_CALLBACK_URL="http://127.0.0.1:8001/internal/progress"
TELEGRAM_PROGRESS_CALLBACK_TOKEN="replace_with_random_progress_callback_token" # Если оставить пустым, используется WEBHOOK_SECRET
TELEGRAM_SERVER_HOST="0.0.0.0"
TELEGRAM_SERVER_PORT="8001"

# Файловый провайдер для Telegram
TELEGRAM_FILE_PROVIDER_TOKEN="replace_with_random_file_provider_token" # Должен совпадать у Gateway и Telegram server; если пусто, используется WEBHOOK_SECRET
TELEGRAM_FILE_PROVIDER_URL="http://127.0.0.1:8001"
TELEGRAM_BOT_INSTANCE_ID="default"
TELEGRAM_MEDIA_GROUP_QUIET_PERIOD_SECONDS="2.5" # Период тишины закрывает состав альбома, но не прерывает активные загрузки
TELEGRAM_MEDIA_GROUP_TEXT_JOIN_WINDOW_SECONDS="10" # Окно точной transport-привязки отдельной текстовой инструкции к одному активному альбому того же bot/chat/thread
TELEGRAM_FORWARDED_TEXT_JOIN_WAIT_SECONDS="1.5" # Только пересланный текст кратко ждёт более ранний альбом из той же массовой пересылки; обычный текст не задерживается
TELEGRAM_MEDIA_GROUP_MAX_LIFETIME_SECONDS="300" # Аварийный предел жизни альбома; частичный InputBatch не коммитится
TELEGRAM_DELIVERY_SPOOL_MEMORY_BYTES="8388608" # До этого размера delivery хранится в RAM, затем переносится на диск

# Telegram READY OutputBatch recovery
TELEGRAM_READY_OUTBOX_POLL_SECONDS="15"
TELEGRAM_READY_OUTBOX_MINIMUM_AGE_SECONDS="30" # Минимальный возраст batch снижает вероятность гонки с обычной synchronous delivery
TELEGRAM_READY_OUTBOX_BATCH_LIMIT="50"

# Telegram progress/final edit UX
PROGRESS_EDIT_MIN_INTERVAL="1.2"
PROGRESS_MAX_TEXT_LENGTH="1000"
TELEGRAM_FINAL_EDIT_MAX_LENGTH="3500"
TELEGRAM_FINAL_DELIVERY_MODE="send_new"
TELEGRAM_FINAL_STATUS_MODE="artefacts_only" # always | artefacts_only | never; управляет отдельным сообщением «Готово.» после подтверждённой доставки

# Конфигурация Web
WEB_API_KEY="replace_with_random_web_api_key"

# Конфигурация CLI
CLI_API_KEY="replace_with_random_cli_api_key"

# Конфигурация Gateway
GATEWAY_URL="http://localhost:8000"
INTERNAL_API_KEY="replace_with_random_internal_api_key" # Полный internal wildcard-доступ для административных и compatibility-маршрутов
PROGRESS_CALLBACK_ALLOWED_PREFIXES="http://127.0.0.1,http://localhost"
CORS_ORIGINS="*"

# Прокси
HTTP_PROXY=""
HTTPS_PROXY=""
NO_PROXY="127.0.0.1,localhost" # Локальные Gateway и Telegram callbacks не должны идти через внешний proxy

# Конфигурация MCP
AGENT_CONFIG_PATH="src/api/mcp.config"
